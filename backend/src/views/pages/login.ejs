<!DOCTYPE html>
<html lang="uz" data-theme="dark">
<head>
  <%- include('../partials/head') %>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      display: flex;
      background: #0a0e1a;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* Enable hardware acceleration */
    .login-btn,
    .theme-toggle,
    .login-feature {
      will-change: transform;
    }

    /* Animated Background - Optimized */
    .animated-bg {
      position: fixed;
      inset: 0;
      background: linear-gradient(135deg, #0a0e1a 0%, #0f1419 100%);
      z-index: 0;
    }

    .login-page {
      display: flex;
      width: 100%;
      min-height: 100vh;
      position: relative;
      z-index: 2;
    }

    .login-left {
      flex: 1;
      background: rgba(15, 23, 42, 0.8);
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 60px;
      position: relative;
      overflow: hidden;
      border-right: 1px solid rgba(59, 130, 246, 0.1);
    }

    .login-brand {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 48px;
      position: relative;
      z-index: 2;
    }

    .login-brand-logo {
      width: 50px;
      height: 50px;
      background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
    }

    .login-brand-name {
      font-size: 24px;
      font-weight: 800;
      background: linear-gradient(135deg, #fff 0%, #3b82f6 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .login-headline {
      font-size: 42px;
      font-weight: 900;
      background: linear-gradient(135deg, #fff 0%, #3b82f6 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      line-height: 1.2;
      margin-bottom: 20px;
      position: relative;
      z-index: 2;
    }

    .login-subtext {
      font-size: 16px;
      color: rgba(255, 255, 255, 0.7);
      line-height: 1.7;
      max-width: 480px;
      margin-bottom: 48px;
      position: relative;
      z-index: 2;
    }

    .login-features {
      display: flex;
      flex-direction: column;
      gap: 20px;
      position: relative;
      z-index: 2;
    }

    .login-feature {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 16px;
      background: rgba(59, 130, 246, 0.05);
      border: 1px solid rgba(59, 130, 246, 0.1);
      border-radius: 12px;
      color: rgba(255, 255, 255, 0.9);
      font-size: 15px;
      transition: all 0.15s ease;
    }

    .login-feature:hover {
      background: rgba(59, 130, 246, 0.1);
      border-color: rgba(59, 130, 246, 0.3);
      transform: translateX(4px);
    }

    .login-feature-icon {
      width: 40px;
      height: 40px;
      background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
    }

    .login-right {
      width: 520px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 60px 50px;
      background: rgba(15, 23, 42, 0.95);
      position: relative;
    }

    .login-form-container {
      width: 100%;
      position: relative;
      z-index: 2;
    }

    .login-title {
      font-size: 32px;
      font-weight: 800;
      margin-bottom: 8px;
      background: linear-gradient(135deg, #fff 0%, #3b82f6 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .login-subtitle {
      font-size: 15px;
      color: rgba(255, 255, 255, 0.6);
      margin-bottom: 36px;
    }

    .password-wrapper {
      position: relative;
    }

    .password-toggle {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      cursor: pointer;
      color: rgba(255, 255, 255, 0.5);
      padding: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: color 0.15s ease;
      z-index: 2;
    }

    .password-toggle:hover {
      color: #3b82f6;
    }

    .login-form {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .form-group {
      position: relative;
    }

    .form-label {
      display: block;
      font-size: 14px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.9);
      margin-bottom: 8px;
    }

    .form-control {
      width: 100%;
      padding: 14px 16px;
      font-size: 15px;
      background: rgba(30, 41, 59, 0.6);
      border: 1px solid rgba(59, 130, 246, 0.2);
      border-radius: 10px;
      color: #fff;
      transition: all 0.15s ease;
    }

    .form-control:focus {
      outline: none;
      border-color: #3b82f6;
      background: rgba(30, 41, 59, 0.8);
    }

    .form-control::placeholder {
      color: rgba(255, 255, 255, 0.4);
    }

    .input-icon {
      position: absolute;
      left: 16px;
      top: 50%;
      transform: translateY(-50%);
      pointer-events: none;
      z-index: 1;
      color: rgba(255, 255, 255, 0.5);
    }

    .login-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .checkbox-label {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      color: rgba(255, 255, 255, 0.7);
      cursor: pointer;
      user-select: none;
      transition: color 0.15s ease;
    }

    .checkbox-label:hover {
      color: #fff;
    }

    .checkbox-label input {
      width: 18px;
      height: 18px;
      accent-color: #3b82f6;
      cursor: pointer;
    }

    .forgot-link {
      font-size: 14px;
      color: #3b82f6;
      text-decoration: none;
      transition: color 0.15s ease;
      font-weight: 500;
    }

    .forgot-link:hover {
      color: #60a5fa;
      text-decoration: underline;
    }

    .login-btn {
      width: 100%;
      padding: 16px;
      font-size: 16px;
      font-weight: 700;
      border-radius: 10px;
      background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
      color: #fff;
      border: none;
      cursor: pointer;
      transition: transform 0.15s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
    }

    .login-btn:hover:not(:disabled) {
      transform: translateY(-1px);
    }

    .login-btn:active:not(:disabled) {
      transform: translateY(0);
    }

    .login-btn:disabled {
      opacity: 0.7;
      cursor: not-allowed;
    }

    .login-btn .spinner {
      width: 18px;
      height: 18px;
      border: 2px solid rgba(255,255,255,0.3);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      display: none;
    }

    .login-btn.loading .spinner { display: block; }
    .login-btn.loading .btn-text { display: none; }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .login-back {
      margin-top: 32px;
      text-align: center;
      font-size: 14px;
    }

    .back-link {
      color: rgba(255, 255, 255, 0.6);
      text-decoration: none;
      transition: color 0.15s ease;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .back-link:hover {
      color: #3b82f6;
    }

    .login-error {
      background: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.3);
      border-radius: 10px;
      padding: 14px 16px;
      font-size: 14px;
      color: #f87171;
      display: none;
    }

    .login-error.show {
      display: block;
    }

    .form-error {
      font-size: 13px;
      color: #f87171;
      margin-top: 6px;
      display: block;
    }

    .demo-box {
      margin-top: 24px;
      padding: 16px;
      background: rgba(30, 41, 59, 0.7);
      border: 1px solid rgba(59, 130, 246, 0.3);
      border-radius: 12px;
      backdrop-filter: blur(8px);
    }
    .demo-box-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 12px;
    }
    .demo-box-title {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      font-weight: 600;
      color: #93c5fd;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .demo-badge {
      font-size: 10px;
      font-weight: 700;
      background: rgba(59, 130, 246, 0.25);
      color: #bfdbfe;
      padding: 2px 8px;
      border-radius: 9999px;
      border: 1px solid rgba(59, 130, 246, 0.4);
    }
    .demo-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }
    .btn-demo-chip {
      background: rgba(15, 23, 42, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 8px;
      padding: 10px 6px;
      text-align: center;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      color: #e2e8f0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      user-select: none;
    }
    .btn-demo-chip:hover {
      border-color: #3b82f6;
      background: rgba(59, 130, 246, 0.2);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(59, 130, 246, 0.25);
    }
    .btn-demo-chip .role-icon {
      font-size: 16px;
      margin-bottom: 2px;
    }
    .btn-demo-chip .role-name {
      font-size: 12px;
      font-weight: 700;
      color: #fff;
    }
    .btn-demo-chip .role-hint {
      font-size: 10px;
      color: #94a3b8;
    }


    @media (max-width: 900px) {
      .login-left { display: none; }
      .login-right {
        width: 100%;
        padding: 40px 24px;
        justify-content: center;
      }
    }
  </style>
</head>
<body>
<div class="animated-bg"></div>
<div class="login-page">
  <div class="login-left">
    <div class="login-brand">
      <div class="login-brand-logo">
        <svg width="28" height="28" fill="none" stroke="#fff" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
        </svg>
      </div>
      <span class="login-brand-name">OmborXona</span>
    </div>
    <h1 class="login-headline">Omboringizni professional boshqaring</h1>
    <p class="login-subtext">Real vaqtda kirim-chiqim, qoldiq kuzatuvi va keng hisobotlar bilan korxonangizni yangi bosqichga olib chiqing.</p>
    <div class="login-features">
      <div class="login-feature">
        <div class="login-feature-icon">
          <svg width="20" height="20" fill="none" stroke="#fff" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10"/>
          </svg>
        </div>
        Real vaqt ombor holati va statistika
      </div>
      <div class="login-feature">
        <div class="login-feature-icon">
          <svg width="20" height="20" fill="none" stroke="#fff" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
        </div>
        PDF va Excel formatida hisobotlar
      </div>
      <div class="login-feature">
        <div class="login-feature-icon">
          <svg width="20" height="20" fill="none" stroke="#fff" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
          </svg>
        </div>
        100% Node.js - Server-Side Rendering
      </div>
    </div>
  </div>

  <div class="login-right">
    <div class="login-form-container">
      <h2 class="login-title">Xush kelibsiz</h2>
      <p class="login-subtitle">Davom etish uchun hisobingizga kiring</p>

      <div id="login-error" class="login-error"></div>

      <form class="login-form" id="login-form" novalidate>
        <div class="form-group">
          <label class="form-label" for="username">Login</label>
          <div style="position:relative">
            <input type="text" id="username" name="username" class="form-control"
              style="padding-left:48px" placeholder="Loginni kiriting"
              autocomplete="username" required>
            <svg class="input-icon" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
          </div>
          <span id="username-error" class="form-error"></span>
        </div>

        <div class="form-group">
          <label class="form-label" for="password">Parol</label>
          <div class="password-wrapper">
            <input type="password" id="password" name="password" class="form-control"
              style="padding-left:48px;padding-right:48px" placeholder="Parolingizni kiriting"
              autocomplete="current-password" required>
            <svg class="input-icon" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
            <button type="button" class="password-toggle" id="password-toggle" title="Parolni ko'rsatish">
              <svg id="eye-icon" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
              </svg>
            </button>
          </div>
          <span id="password-error" class="form-error"></span>
        </div>

        <div class="login-meta">
          <label class="checkbox-label">
            <input type="checkbox" id="remember-me">
            Meni eslab qol
          </label>
          <a href="#" class="forgot-link" onclick="showForgotPassword()">Parolni unutdingizmi?</a>
        </div>

        <button type="submit" class="login-btn" id="login-btn">
          <div class="spinner"></div>
          <span class="btn-text">Kirish</span>
        </button>
      </form>

      <div class="demo-box">
        <div class="demo-box-header">
          <div class="demo-box-title">
            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
            <span>Tezkor Demo Hisoblar</span>
          </div>
          <span class="demo-badge">1-Bosishda Kirish</span>
        </div>
        <div class="demo-grid">
          <button type="button" class="btn-demo-chip" onclick="fillDemo('admin', 'admin123')" title="Admin sifatida kirish">
            <span class="role-icon">
              <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            </span>
            <span class="role-name">Admin</span>
            <span class="role-hint">To'liq huquq</span>
          </button>
          <button type="button" class="btn-demo-chip" onclick="fillDemo('operator', 'operator123')" title="Operator sifatida kirish">
            <span class="role-icon">
              <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            </span>
            <span class="role-name">Operator</span>
            <span class="role-hint">Kirim-chiqim</span>
          </button>
          <button type="button" class="btn-demo-chip" onclick="fillDemo('omborchi', 'omborchi123')" title="Omborchi sifatida kirish">
            <span class="role-icon">
              <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
            </span>
            <span class="role-name">Omborchi</span>
            <span class="role-hint">Ombor nazorati</span>
          </button>
        </div>
      </div>

      <p class="login-back">
        <a href="/" class="back-link">
          <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          Bosh sahifaga qaytish
        </a>
      </p>
    </div>
  </div>
</div>

<div id="toast-container" class="toast-container"></div>

<%- include('../partials/scripts') %>
<script>
  ThemeManager.init();

  if (Auth.isAuthenticated()) {
    window.location.href = '/dashboard';
  }

  const passwordInput = document.getElementById('password');
  const eyeIcon = document.getElementById('eye-icon');
  let passwordVisible = false;

  document.getElementById('password-toggle').addEventListener('click', () => {
    passwordVisible = !passwordVisible;
    passwordInput.type = passwordVisible ? 'text' : 'password';
    eyeIcon.innerHTML = passwordVisible
      ? `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>`
      : `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>`;
  });

  document.getElementById('login-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const username = document.getElementById('username').value.trim();
    const password = document.getElementById('password').value;
    const rememberMe = document.getElementById('remember-me').checked;
    const errorDiv = document.getElementById('login-error');
    const btn = document.getElementById('login-btn');

    document.getElementById('username-error').textContent = '';
    document.getElementById('password-error').textContent = '';
    errorDiv.classList.remove('show');

    let valid = true;
    if (!username) {
      document.getElementById('username-error').textContent = 'Foydalanuvchi nomi talab qilinadi';
      valid = false;
    }
    if (!password) {
      document.getElementById('password-error').textContent = 'Parol talab qilinadi';
      valid = false;
    }
    if (!valid) return;

    btn.classList.add('loading');
    btn.disabled = true;

    try {
      const data = await api.post('/auth/login', { username, password });
      api.setTokens(data.data.accessToken, data.data.refreshToken);
      api.setUser(data.data.user);
      if (rememberMe) {
        localStorage.setItem('rememberMe', 'true');
      }
      Toast.success('Tizimga muvaffaqiyatli kirdingiz');
      setTimeout(() => {
        window.location.href = '/dashboard';
      }, 800);
    } catch (error) {
      errorDiv.textContent = error.message;
      errorDiv.classList.add('show');
      btn.classList.remove('loading');
      btn.disabled = false;
    }
  });

  function showForgotPassword() {
    Toast.info('Parolni tiklash uchun administratorga murojaat qiling');
  }

  function fillDemo(username, password) {
    const uInput = document.getElementById('username');
    const pInput = document.getElementById('password');
    uInput.value = username;
    pInput.value = password;
    uInput.dispatchEvent(new Event('input', { bubbles: true }));
    pInput.dispatchEvent(new Event('input', { bubbles: true }));
    // Avtomatik kirishni ishga tushiramiz
    document.getElementById('login-form').dispatchEvent(new Event('submit', { cancelable: true }));
  }
</script>
</body>
</html>
