<!DOCTYPE html>
<html lang="uz" data-theme="dark">
<head>
  <%- include('../partials/head') %>
</head>
<body>
<div class="admin-layout" id="admin-layout">
  <%- include('../partials/sidebar') %>
  <div class="main-content">
    <%- include('../partials/navbar') %>
    <main class="page-content">
      <div class="page-header">
        <div>
          <h1 class="page-title">Kategoriyalar</h1>
          <p class="page-subtitle">Mahsulot kategoriyalarini boshqarish</p>
        </div>
        <button class="btn btn-primary" onclick="openModal()" id="add-category-btn">
          <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          Yangi kategoriya
        </button>
      </div>
      <div class="card">
        <div class="card-header">
          <div class="search-bar">
            <svg class="search-icon" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <input type="text" id="search-input" class="form-control" placeholder="Kategoriya nomi..." style="width:260px">
          </div>
          <span id="total-count" class="text-sm text-muted"></span>
        </div>
        <div class="table-container">
          <table class="table">
            <thead><tr><th>Nomi</th><th>Izoh</th><th>Mahsulotlar soni</th><th>Holat</th><th style="width:100px">Amallar</th></tr></thead>
            <tbody id="categories-table"></tbody>
          </table>
        </div>
        <div class="card-footer" style="display:flex;justify-content:flex-end">
          <div id="pagination"></div>
        </div>
      </div>
    </main>
  </div>
</div>

<div class="modal-overlay" id="cat-modal">
  <div class="modal" style="max-width:440px">
    <div class="modal-header">
      <h3 class="modal-title" id="modal-title">Yangi kategoriya</h3>
      <button class="modal-close" onclick="closeModal()">&#215;</button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label class="form-label">Kategoriya nomi <span style="color:var(--danger)">*</span></label>
        <input type="text" id="cat-name" class="form-control" placeholder="Kategoriya nomi">
        <span id="cat-name-error" class="form-error"></span>
      </div>
      <div class="form-group" style="margin-top:16px">
        <label class="form-label">Izoh</label>
        <textarea id="cat-desc" class="form-control" rows="3" placeholder="Qo'shimcha izoh..."></textarea>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-secondary" onclick="closeModal()">Bekor qilish</button>
      <button class="btn btn-primary" id="save-btn" onclick="saveCategory()">Saqlash</button>
    </div>
  </div>
</div>

<div id="toast-container" class="toast-container"></div>

<%- include('../partials/scripts') %>

<script>
  if (!Layout.init()) throw new Error('Auth failed');
  Layout.setBreadcrumb([{label: 'Ma\'lumotlar'}, {label: 'Kategoriyalar'}]);

  const user = Auth.getUser();
  const isAdmin = user?.role?.name === 'Admin';
  const isOperator = user?.role?.name === 'Operator';
  const canManage = isAdmin || isOperator;

  if (!canManage) {
    const addBtn = document.getElementById('add-category-btn');
    if (addBtn) addBtn.style.display = 'none';
  }

  let currentPage = 1, editingId = null;

  document.getElementById('search-input').addEventListener('input', Utils.debounce(() => { currentPage = 1; loadCategories(); }, 400));

  async function loadCategories() {
    const tbody = document.getElementById('categories-table');
    tbody.innerHTML = Utils.getSkeletonRows(5, 4);
    try {
      const params = { page: currentPage, limit: 15 };
      const s = document.getElementById('search-input').value.trim();
      if (s) params.search = s;
      const data = await api.get('/categories', params);
      renderTable(data.data);
      const p = data.pagination;
      document.getElementById('total-count').textContent = `Jami: ${p.total} ta`;
      const paginationEl = document.getElementById('pagination');
      paginationEl.innerHTML = Utils.generatePaginationHTML(p);
      Utils.setupPagination(paginationEl, pg => { currentPage = pg; loadCategories(); });
    } catch(e) { Toast.error(e.message); }
  }

  function renderTable(cats) {
    const tbody = document.getElementById('categories-table');
    if (!cats.length) {
      tbody.innerHTML = `<tr><td colspan="5"><div class="empty-state"><div class="empty-state-title">Kategoriya topilmadi</div></div></td></tr>`;
      return;
    }
    tbody.innerHTML = cats.map(c => `<tr>
      <td><span style="font-weight:500">${Utils.escapeHtml(c.name)}</span></td>
      <td class="text-muted">${Utils.truncate(c.description || '-', 50)}</td>
      <td>${c._count?.products || 0} ta mahsulot</td>
      <td><span class="badge ${c.isActive ? 'badge-success' : 'badge-secondary'}">${c.isActive ? 'Faol' : 'Faol emas'}</span></td>
      <td>
        ${canManage ? `
        <div class="table-actions">
          <button class="btn btn-secondary btn-sm btn-icon" onclick="editCategory('${c.id}')" title="Tahrirlash">
            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
          </button>
          <button class="btn btn-danger btn-sm btn-icon" onclick="deleteCategory('${c.id}', ${JSON.stringify(c.name).replace(/"/g, '&quot;')})" title="O'chirish">
            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          </button>
        </div>
        ` : '<span class="text-muted text-sm">-</span>'}
      </td>
    </tr>`).join('');
  }

  function openModal(id = null) {
    editingId = id;
    document.getElementById('modal-title').textContent = id ? 'Kategoriyani tahrirlash' : 'Yangi kategoriya';
    document.getElementById('cat-name').value = '';
    document.getElementById('cat-desc').value = '';
    Utils.clearFormErrors('cat-modal');
    document.getElementById('cat-modal').classList.add('active');
  }

  function closeModal() {
    document.getElementById('cat-modal').classList.remove('active');
    editingId = null;
    Utils.clearFormErrors('cat-modal');
  }

  async function editCategory(id) {
    try {
      const data = await api.get(`/categories/${id}`);
      const c = data.data;
      openModal(id);
      document.getElementById('cat-name').value = c.name;
      document.getElementById('cat-desc').value = c.description || '';
    } catch(e) { Utils.handleApiError(e); }
  }

  async function saveCategory() {
    Utils.clearFormErrors('cat-modal');
    const name = document.getElementById('cat-name').value.trim();
    const catNameInput = document.getElementById('cat-name');
    const err = document.getElementById('cat-name-error');
    err.textContent = '';
    if (!name) { 
      err.textContent = 'Nom talab qilinadi'; 
      catNameInput.classList.add('is-invalid');
      catNameInput.focus();
      return; 
    }

    const btn = document.getElementById('save-btn');
    btn.disabled = true;
    btn.textContent = 'Saqlanmoqda...';

    try {
      const body = { name, description: document.getElementById('cat-desc').value.trim() || undefined };
      if (editingId) {
        await api.put(`/categories/${editingId}`, body);
        Toast.success('Kategoriya yangilandi');
      } else {
        await api.post('/categories', body);
        Toast.success('Kategoriya qo\'shildi');
      }
      closeModal();
      loadCategories();
    } catch(e) { 
      Utils.handleApiError(e, 'cat-modal'); 
    }
    finally { btn.disabled = false; btn.textContent = 'Saqlash'; }
  }

  async function deleteCategory(id, name) {
    Confirm.show(`"${name}" kategoriyasini o'chirishni tasdiqlaysizmi?`, 'O\'chirishni tasdiqlash', async () => {
      try {
        await api.delete(`/categories/${id}`);
        Toast.success('Kategoriya o\'chirildi');
        loadCategories();
      } catch(e) { Utils.handleApiError(e); }
    });
  }

  document.getElementById('cat-modal').addEventListener('click', e => {
    if (e.target === document.getElementById('cat-modal')) closeModal();
  });

  loadCategories();
</script>
</body>
</html>
