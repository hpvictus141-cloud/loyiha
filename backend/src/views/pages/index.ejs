<!DOCTYPE html>
<html lang="uz" data-theme="dark">
<head>
  <%- include('../partials/head') %>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
      color: #fff;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* Optimized Background - No Animation */
    .bg-decoration {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      pointer-events: none;
    }

    .bg-decoration::before {
      content: '';
      position: absolute;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(59, 130, 246, 0.08) 0%, transparent 70%);
      top: -100px;
      right: -100px;
    }

    .bg-decoration::after {
      content: '';
      position: absolute;
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(99, 102, 241, 0.06) 0%, transparent 70%);
      bottom: -100px;
      left: -100px;
    }

    /* Header */
    .landing-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      padding: 18px 40px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(15, 23, 42, 0.95);
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 22px;
      font-weight: 700;
      color: #fff;
    }

    .logo-icon {
      width: 38px;
      height: 38px;
      background: linear-gradient(135deg, #3b82f6 0%, #6366f1 100%);
      border-radius: 9px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .btn-login {
      padding: 9px 26px;
      background: linear-gradient(135deg, #3b82f6 0%, #6366f1 100%);
      color: #fff;
      border: none;
      border-radius: 9px;
      font-weight: 600;
      font-size: 14px;
      cursor: pointer;
      text-decoration: none;
    }

    .btn-login:hover {
      opacity: 0.9;
    }

    /* Hero Section */
    .landing-container {
      position: relative;
      z-index: 1;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .hero-section {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 110px 40px 70px;
      text-align: center;
    }

    .hero-content {
      max-width: 860px;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 18px;
      background: rgba(59, 130, 246, 0.1);
      border: 1px solid rgba(59, 130, 246, 0.3);
      border-radius: 50px;
      color: #60a5fa;
      font-size: 13px;
      font-weight: 500;
      margin-bottom: 26px;
    }

    .hero-title {
      font-size: 64px;
      font-weight: 800;
      line-height: 1.1;
      margin-bottom: 20px;
      background: linear-gradient(135deg, #fff 0%, #94a3b8 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-subtitle {
      font-size: 20px;
      color: #94a3b8;
      margin-bottom: 34px;
      line-height: 1.6;
    }

    .hero-buttons {
      display: flex;
      gap: 14px;
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;
    }

    .btn-primary {
      padding: 14px 36px;
      background: linear-gradient(135deg, #3b82f6 0%, #6366f1 100%);
      color: #fff;
      border: none;
      border-radius: 11px;
      font-weight: 600;
      font-size: 16px;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .btn-primary:hover {
      opacity: 0.9;
    }

    .btn-secondary {
      padding: 14px 36px;
      background: rgba(255, 255, 255, 0.05);
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 11px;
      font-weight: 600;
      font-size: 16px;
      cursor: pointer;
      text-decoration: none;
    }

    .btn-secondary:hover {
      background: rgba(255, 255, 255, 0.08);
    }

    /* Features */
    .features-section {
      padding: 70px 40px;
      background: rgba(255, 255, 255, 0.02);
    }

    .features-container {
      max-width: 1200px;
      margin: 0 auto;
    }

    .features-title {
      text-align: center;
      font-size: 42px;
      font-weight: 700;
      margin-bottom: 50px;
      color: #fff;
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 24px;
    }

    .feature-card {
      padding: 28px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 14px;
    }

    .feature-icon {
      width: 52px;
      height: 52px;
      background: linear-gradient(135deg, #3b82f6 0%, #6366f1 100%);
      border-radius: 11px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 18px;
    }

    .feature-title {
      font-size: 20px;
      font-weight: 600;
      margin-bottom: 10px;
      color: #fff;
    }

    .feature-description {
      font-size: 14px;
      color: #94a3b8;
      line-height: 1.5;
    }

    /* Stats */
    .stats-section {
      padding: 50px 40px;
      text-align: center;
    }

    .stats-grid {
      max-width: 1000px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 30px;
    }

    .stat-item {
      padding: 16px;
    }

    .stat-number {
      font-size: 40px;
      font-weight: 800;
      background: linear-gradient(135deg, #3b82f6 0%, #6366f1 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 6px;
    }

    .stat-label {
      font-size: 15px;
      color: #94a3b8;
    }

    /* Demo Quick Access */
    .demo-bar {
      max-width: 1100px;
      margin: 0 auto 50px;
      padding: 24px 30px;
      background: rgba(30, 41, 59, 0.6);
      border: 1px solid rgba(59, 130, 246, 0.25);
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      flex-wrap: wrap;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    }

    .demo-bar-text h3 {
      font-size: 18px;
      font-weight: 700;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 4px;
    }

    .demo-bar-text p {
      font-size: 13px;
      color: #94a3b8;
    }

    .demo-chips {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .demo-chip {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 18px;
      background: rgba(15, 23, 42, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 10px;
      color: #f1f5f9;
      text-decoration: none;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .demo-chip:hover {
      background: rgba(59, 130, 246, 0.2);
      border-color: #3b82f6;
      transform: translateY(-2px);
      box-shadow: 0 4px 14px rgba(59, 130, 246, 0.3);
    }

    .demo-chip-role {
      font-size: 10px;
      color: #93c5fd;
      background: rgba(59, 130, 246, 0.25);
      padding: 2px 6px;
      border-radius: 4px;
    }

    /* Live Warehouse Showcase */
    .showcase-section {
      padding: 60px 40px;
      max-width: 1200px;
      margin: 0 auto;
    }

    .showcase-header {
      text-align: center;
      margin-bottom: 36px;
    }

    .showcase-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 14px;
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.3);
      border-radius: 50px;
      color: #34d399;
      font-size: 12px;
      font-weight: 600;
      margin-bottom: 14px;
    }

    .showcase-title {
      font-size: 36px;
      font-weight: 800;
      color: #fff;
      margin-bottom: 12px;
    }

    .showcase-subtitle {
      font-size: 16px;
      color: #94a3b8;
      max-width: 650px;
      margin: 0 auto;
    }

    /* Category pills */
    .category-pills {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      justify-content: center;
      margin-bottom: 30px;
    }

    .pill-btn {
      padding: 7px 16px;
      border-radius: 30px;
      font-size: 13px;
      font-weight: 500;
      background: rgba(255, 255, 255, 0.05);
      color: #cbd5e1;
      border: 1px solid rgba(255, 255, 255, 0.1);
      cursor: pointer;
      transition: all 0.2s;
    }

    .pill-btn:hover, .pill-btn.active {
      background: #3b82f6;
      color: #fff;
      border-color: #3b82f6;
    }

    /* Search in showcase */
    .showcase-search-bar {
      max-width: 460px;
      margin: 0 auto 30px;
      position: relative;
    }

    .showcase-search-input {
      width: 100%;
      padding: 12px 18px 12px 44px;
      background: rgba(15, 23, 42, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 12px;
      color: #fff;
      font-size: 14px;
      outline: none;
      transition: border 0.2s;
    }

    .showcase-search-input:focus {
      border-color: #3b82f6;
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
    }

    .showcase-search-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: #64748b;
    }

    /* Showcase Table */
    .showcase-table-wrap {
      background: rgba(15, 23, 42, 0.7);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    .showcase-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    .showcase-table th {
      padding: 14px 18px;
      background: rgba(30, 41, 59, 0.8);
      color: #94a3b8;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .showcase-table td {
      padding: 14px 18px;
      font-size: 14px;
      color: #e2e8f0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .showcase-table tr:hover {
      background: rgba(255, 255, 255, 0.02);
    }

    .badge-code {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 4px 10px;
      background: rgba(59, 130, 246, 0.15);
      border: 1px solid rgba(59, 130, 246, 0.3);
      border-radius: 999px;
      color: #93c5fd;
      font-size: 11.5px;
      font-weight: 600;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      letter-spacing: 0.3px;
      white-space: nowrap;
      line-height: 1.25;
      text-align: center;
      min-width: 66px;
      box-sizing: border-box;
    }

    .badge-stock-ok {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 9px;
      background: rgba(16, 185, 129, 0.15);
      color: #34d399;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
    }

    .badge-stock-low {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 9px;
      background: rgba(239, 68, 68, 0.15);
      color: #f87171;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
    }

    .showcase-footer-actions {
      padding: 18px 24px;
      background: rgba(30, 41, 59, 0.4);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    /* Footer */
    .landing-footer {
      padding: 50px 40px 30px;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
      background: rgba(0, 0, 0, 0.2);
    }

    .footer-content {
      max-width: 1200px;
      margin: 0 auto;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 40px;
      margin-bottom: 40px;
    }

    .footer-section h3 {
      font-size: 16px;
      font-weight: 600;
      margin-bottom: 16px;
      color: #fff;
    }

    .footer-section p {
      font-size: 14px;
      color: #94a3b8;
      line-height: 1.6;
      margin-bottom: 20px;
    }

    .footer-links {
      list-style: none;
    }

    .footer-links li {
      margin-bottom: 10px;
    }

    .footer-links a {
      color: #94a3b8;
      text-decoration: none;
      font-size: 14px;
      transition: color 0.2s;
    }

    .footer-links a:hover {
      color: #3b82f6;
    }

    .social-links {
      display: flex;
      gap: 12px;
      margin-top: 20px;
    }

    .social-link {
      width: 38px;
      height: 38px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #94a3b8;
      text-decoration: none;
      transition: all 0.2s;
    }

    .social-link:hover {
      background: rgba(59, 130, 246, 0.1);
      border-color: rgba(59, 130, 246, 0.3);
      color: #3b82f6;
    }

    .footer-bottom {
      padding-top: 30px;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: #64748b;
      font-size: 14px;
    }

    .footer-bottom-links {
      display: flex;
      gap: 20px;
    }

    .footer-bottom-links a {
      color: #64748b;
      text-decoration: none;
    }

    .footer-bottom-links a:hover {
      color: #94a3b8;
    }

    @media (max-width: 968px) {
      .footer-grid {
        grid-template-columns: 1fr 1fr;
        gap: 30px;
      }
    }

    @media (max-width: 768px) {
      .hero-title { font-size: 42px; }
      .hero-subtitle { font-size: 17px; }
      .features-title { font-size: 32px; }
      .landing-header { padding: 14px 20px; }
      .hero-section { padding: 90px 20px 50px; }
      .footer-grid {
        grid-template-columns: 1fr;
        gap: 30px;
      }
      .footer-bottom {
        flex-direction: column;
        gap: 16px;
        text-align: center;
      }
    }
  </style>
</head>
<body>
  <div class="bg-decoration"></div>
  
  <header class="landing-header">
    <div class="logo">
      <div class="logo-icon">
        <svg width="22" height="22" fill="none" stroke="#fff" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
        </svg>
      </div>
      <span>OmborXona</span>
    </div>
    <a href="/login" class="btn-login">Kirish →</a>
  </header>

  <div class="landing-container">
    <section class="hero-section">
      <div class="hero-content">
        <div class="hero-badge">
          <svg width="15" height="15" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          100% Node.js & Server-Side Rendering
        </div>
        
        <h1 class="hero-title">
          Professional<br/>
          Omborxona Tizimi
        </h1>
        
        <p class="hero-subtitle">
          Zamonaviy texnologiyalar asosida ishlab chiqilgan professional omborxona<br/>
          boshqaruv tizimi. Real-time yangilanishlar, to'liq audit va hisobotlar.
        </p>
        
        <div class="hero-buttons">
          <a href="/login" class="btn-primary">
            Boshlash
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
            </svg>
          </a>
          <a href="#features" class="btn-secondary">Imkoniyatlar</a>
        </div>
      </div>
    </section>

    <section class="stats-section">
      <div class="stats-grid">
        <div class="stat-item">
          <div class="stat-number"><%= (typeof stats !== 'undefined' && stats.productsCount) ? stats.productsCount : 67 %>+</div>
          <div class="stat-label">Mahsulot turlari</div>
        </div>
        <div class="stat-item">
          <div class="stat-number"><%= (typeof stats !== 'undefined' && stats.categoriesCount) ? stats.categoriesCount : 14 %>+</div>
          <div class="stat-label">Kategoriyalar</div>
        </div>
        <div class="stat-item">
          <div class="stat-number"><%= (typeof stats !== 'undefined' && stats.suppliersCount) ? stats.suppliersCount : 15 %>+</div>
          <div class="stat-label">Yetkazib beruvchilar</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">100%</div>
          <div class="stat-label">Real-time Sinxronizatsiya</div>
        </div>
      </div>
    </section>

    <!-- Quick Demo Access Bar -->
    <div class="demo-bar">
      <div class="demo-bar-text">
        <h3>
          <svg width="20" height="20" fill="none" stroke="#3b82f6" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
          Tezkor Demo Sinov (1-klik bilan kirish)
        </h3>
        <p>Tizimni sinash uchun rolni tanlang — ma'lumotlar avtomatik kiritiladi va tizimga kiriladi</p>
      </div>
      <div class="demo-chips">
        <button type="button" class="demo-chip" onclick="quickLogin('admin', 'admin123')">
          <span style="display:inline-flex;align-items:center;gap:6px">
            <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            Admin
          </span>
          <span class="demo-chip-role">To'liq huquq</span>
        </button>
        <button type="button" class="demo-chip" onclick="quickLogin('operator', 'operator123')">
          <span style="display:inline-flex;align-items:center;gap:6px">
            <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            Operator
          </span>
          <span class="demo-chip-role">Kirim-Chiqim</span>
        </button>
        <button type="button" class="demo-chip" onclick="quickLogin('omborchi', 'omborchi123')">
          <span style="display:inline-flex;align-items:center;gap:6px">
            <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
            Omborchi
          </span>
          <span class="demo-chip-role">Ombor nazorati</span>
        </button>
      </div>
    </div>

    <!-- Live Warehouse Showcase Section -->
    <section class="showcase-section" id="showcase">
      <div class="showcase-header">
        <div class="showcase-badge">
          <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Jonli Ombor Ma'lumotlari
        </div>
        <h2 class="showcase-title">Ombordagi Mahsulotlar Namunasi</h2>
        <p class="showcase-subtitle">Bazadagi real ma'lumotlar: real narxlar, qoldiqlar, toifalar va minimal chegara holati</p>
      </div>

      <% if (typeof topCategories !== 'undefined' && topCategories.length > 0) { %>
      <div class="category-pills">
        <button class="pill-btn active" onclick="filterCategory('all', this)">Barchasi</button>
        <% topCategories.forEach(cat => { %>
          <button class="pill-btn" onclick="filterCategory('<%= cat.name %>', this)">
            <%= cat.name %> (<%= cat._count ? cat._count.products : 0 %>)
          </button>
        <% }) %>
      </div>
      <% } %>

