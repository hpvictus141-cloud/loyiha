              <% sampleProducts.forEach(prod => { 
                  const isLow = Number(prod.currentStock) <= Number(prod.minStock);
              %>
                <tr class="product-row" data-name="<%= prod.name.toLowerCase() %>" data-code="<%= prod.code.toLowerCase() %>" data-category="<%= prod.category ? prod.category.name : '' %>">
