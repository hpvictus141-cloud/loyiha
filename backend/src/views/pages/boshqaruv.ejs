<!DOCTYPE html>
<html lang="uz" data-theme="dark">
<head>
  <%- include('../partials/head') %>
  <style>
    .management-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px;
      margin-bottom: 28px;
    }

    .mgmt-card {
      background: rgba(15, 23, 42, 0.95);
      border: 1px solid rgba(59, 130, 246, 0.2);
      border-radius: 16px;
      padding: 24px;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
    }

    .mgmt-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, #3b82f6, #60a5fa);
      opacity: 0;
      transition: opacity 0.25s ease;
    }

    .mgmt-card:hover {
      transform: translateY(-3px);
      border-color: rgba(59, 130, 246, 0.45);
      box-shadow: 0 16px 32px rgba(0, 0, 0, 0.45), 0 0 20px rgba(59, 130, 246, 0.15);
    }

    .mgmt-card:hover::before {
      opacity: 1;
    }

    .mgmt-icon-wrap {
      width: 52px;
      height: 52px;
      border-radius: 12px;
      background: rgba(59, 130, 246, 0.12);
      border: 1px solid rgba(59, 130, 246, 0.25);
      color: #60a5fa;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 16px;
    }

    .mgmt-card-title {
      font-size: 18px;
      font-weight: 700;
      color: #f1f5f9;
      margin-bottom: 8px;
    }

    .mgmt-card-desc {
      font-size: 13.5px;
      color: #94a3b8;
      line-height: 1.5;
      margin-bottom: 20px;
      flex: 1;
    }

    .mgmt-card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      padding-top: 14px;
      margin-top: auto;
    }

    .mgmt-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      background: #2563eb;
      color: #ffffff;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .mgmt-btn:hover {
      background: #1d4ed8;
      transform: translateX(2px);
    }

    .mgmt-meta-tag {
      font-size: 12px;
      color: #64748b;
      font-weight: 500;
    }

    .system-status-banner {
      background: linear-gradient(135deg, rgba(30, 58, 138, 0.35) 0%, rgba(15, 23, 42, 0.85) 100%);
      border: 1px solid rgba(59, 130, 246, 0.3);
      border-radius: 16px;
      padding: 22px 26px;
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
    }

    .status-badge-live {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 12px;
      border-radius: 20px;
      background: rgba(16, 185, 129, 0.15);
      border: 1px solid rgba(16, 185, 129, 0.3);
      color: #34d399;
      font-size: 12px;
      font-weight: 600;
    }

    .status-dot-pulse {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #10b981;
      box-shadow: 0 0 0 rgba(16, 185, 129, 0.4);
      animation: statusPulse 2s infinite;
    }

    @keyframes statusPulse {
      0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.6); }
      70% { box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
      100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }
  </style>
</head>
<body>
<div class="admin-layout" id="admin-layout">
  <%- include('../partials/sidebar') %>
  <div class="main-content">
    <%- include('../partials/navbar') %>
    <main class="page-content">
      <div class="page-header">
        <div>
          <h1 class="page-title">Boshqaruv Paneli</h1>
          <p class="page-subtitle">Tizim ma'muriyati, xavfsizlik, foydalanuvchilar va umumiy konfiguratsiya markazi</p>
        </div>
      </div>

      <!-- Tizim holati info banner -->
      <div class="system-status-banner">
        <div style="display:flex;align-items:center;gap:14px">
          <div class="mgmt-icon-wrap" style="margin-bottom:0">
            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <div>
            <div style="font-size:16px;font-weight:700;color:#f1f5f9;margin-bottom:3px">OmborXona Tizimi Faol</div>
            <div style="font-size:13px;color:#94a3b8">Barcha ma'lumotlar bazasi va avtorizatsiya protokollari xavfsiz holatda ishlamoqda</div>
          </div>
        </div>
        <div style="display:flex;align-items:center;gap:12px">
          <div class="status-badge-live">
            <span class="status-dot-pulse"></span>
            Tizim Ishlamoqda
          </div>
        </div>
      </div>

      <!-- Asosiy Boshqaruv Bo'limlari Kartochkalari -->
      <div class="management-grid">
        <!-- 1. Foydalanuvchilar -->
        <div class="mgmt-card">
          <div>
            <div class="mgmt-icon-wrap">
              <svg width="26" height="26" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div class="mgmt-card-title">Foydalanuvchilar</div>
            <div class="mgmt-card-desc">
              Xodimlar akkauntlarini boshqarish, yangi admin yoki operator qo'shish, rollar taqsimlash va parollarni tiklash.
            </div>
          </div>
          <div class="mgmt-card-footer">
            <span class="mgmt-meta-tag">Rollar: Admin, Operator</span>
            <a href="/users" class="mgmt-btn">
              Kirish
              <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>

        <!-- 2. Sozlamalar -->
        <div class="mgmt-card">
          <div>
            <div class="mgmt-icon-wrap">
              <svg width="26" height="26" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div class="mgmt-card-title">Tizim Sozlamalari</div>
            <div class="mgmt-card-desc">
              Korxona rekvizitlari, valyuta parametrlari, bildirishnoma sozlamalari hamda interfeys mavzularini sozlash.
            </div>
          </div>
          <div class="mgmt-card-footer">
            <span class="mgmt-meta-tag">Konfiguratsiya</span>
            <a href="/settings" class="mgmt-btn">
              Kirish
              <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>

        <!-- 3. Shaxsiy Profil -->
        <div class="mgmt-card">
          <div>
            <div class="mgmt-icon-wrap">
              <svg width="26" height="26" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
            </div>
            <div class="mgmt-card-title">Shaxsiy Profil</div>
            <div class="mgmt-card-desc">
              O'z ma'lumotlaringiz, login va aloqa ma'lumotlari, xavfsizlik parolini o'zgartirish va faollik holati.
            </div>
          </div>
          <div class="mgmt-card-footer">
            <span class="mgmt-meta-tag">Shaxsiy</span>
            <a href="/profile" class="mgmt-btn">
              Kirish
              <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>

        <!-- 4. Harakatlar Tarixi (Audit Logs) -->
        <div class="mgmt-card">
          <div>
            <div class="mgmt-icon-wrap">
              <svg width="26" height="26" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
              </svg>
            </div>
            <div class="mgmt-card-title">Harakatlar Tarixi</div>
            <div class="mgmt-card-desc">
              Tizimda barcha foydalanuvchilar tomonidan bajarilgan amallar, kirim-chiqimlar va ma'lumotlar o'zgarishi jurnali.
            </div>
          </div>
          <div class="mgmt-card-footer">
            <span class="mgmt-meta-tag">Audit va Xavfsizlik</span>
            <a href="/audit-logs" class="mgmt-btn">
              Kirish
              <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<div id="toast-container" class="toast-container"></div>

<%- include('../partials/scripts') %>

<script>
  if (!Layout.init()) throw new Error('Auth failed');
  // Breadcrumb'da faol joriy sahifa Boshqaruv
  Layout.setBreadcrumb([{ label: 'Boshqaruv' }]);
</script>
</body>
</html>
