<!DOCTYPE html>
<html lang="uz" data-theme="dark">
<head>
  <%- include('../partials/head') %>
  <style>
    .settings-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 24px;
      align-items: start;
    }
    @media (max-width: 1024px) {
      .settings-grid { grid-template-columns: 1fr; }
    }
    .theme-picker-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 8px;
    }
    .theme-card-option {
      border: 2px solid var(--border);
      border-radius: 10px;
      padding: 14px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 12px;
      background: var(--bg-secondary);
      transition: all 0.2s ease;
    }
    .theme-card-option:hover {
      border-color: var(--primary);
      transform: translateY(-1px);
    }
    .theme-card-option.active {
      border-color: var(--primary);
      background: rgba(59, 130, 246, 0.1);
    }
    .theme-icon {
      width: 36px;
      height: 36px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }
    .quick-link-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 14px;
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid var(--border);
      text-decoration: none;
      color: var(--text-primary);
      transition: all 0.2s ease;
    }
    .quick-link-item:hover {
      background: rgba(59, 130, 246, 0.1);
      border-color: rgba(59, 130, 246, 0.3);
      color: #fff;
      transform: translateX(4px);
    }
    .sys-stat-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 0;
      border-bottom: 1px solid var(--border);
      font-size: 13px;
    }
    .sys-stat-row:last-child {
      border-bottom: none;
    }
  </style>
</head>
<body>
<div class="admin-layout" id="admin-layout">
  <%- include('../partials/sidebar') %>

  <div class="main-content">
    <%- include('../partials/navbar') %>

    <main class="page-content">
      <div class="page-header">
        <div>
          <h1 class="page-title">Sozlamalar</h1>
          <p class="page-subtitle">Tizim, korxona va shaxsiy parametrlarni boshqarish</p>
        </div>
      </div>

      <div class="settings-grid">
        <!-- ============ CHAP: KORXONA SOZLAMALARI ============ -->
        <div class="card">
          <div class="card-header">
            <h3 class="card-title">Korxona ma'lumotlari</h3>
            <span class="badge badge-info">Asosiy</span>
          </div>
          <div class="card-body">
            <form id="settings-form" style="display:flex;flex-direction:column;gap:18px" novalidate>
              <div class="form-group">
                <label class="form-label" for="set-companyName">Korxona nomi <span style="color:var(--danger)">*</span></label>
                <input type="text" id="set-companyName" class="form-control" placeholder="Masalan: OmborXona MCHJ">
                <span id="set-companyName-error" class="form-error"></span>
              </div>

              <div class="grid grid-2" style="gap:16px">
                <div class="form-group">
                  <label class="form-label" for="set-phone">Telefon raqami</label>
                  <input type="text" id="set-phone" class="form-control" placeholder="+998 (__) ___-__-__">
                </div>
                <div class="form-group">
                  <label class="form-label" for="set-taxId">STIR (INN)</label>
                  <input type="text" id="set-taxId" class="form-control" placeholder="123456789">
                </div>
              </div>

              <div class="form-group">
                <label class="form-label" for="set-address">Korxona manzili</label>
                <textarea id="set-address" class="form-control" rows="2" placeholder="Toshkent sh., Chilonzor tumani..." style="resize:none;min-height:50px;max-height:140px;overflow-y:auto;"></textarea>
              </div>

              <div class="grid grid-2" style="gap:16px">
                <div class="form-group">
                  <label class="form-label" for="set-currency">Asosiy valyuta</label>
                  <select id="set-currency" class="form-control">
                    <option value="UZS">O'zbek so'mi (UZS)</option>
                    <option value="USD">AQSh dollari (USD)</option>
                    <option value="EUR">Yevro (EUR)</option>
                    <option value="RUB">Rossiya rubli (RUB)</option>
                  </select>
                </div>
                <div class="form-group">
                  <label class="form-label" for="set-dateFormat">Sana ko'rinishi formati</label>
                  <select id="set-dateFormat" class="form-control">
                    <option value="DD.MM.YYYY">DD.MM.YYYY (31.12.2026)</option>
                    <option value="YYYY-MM-DD">YYYY-MM-DD (2026-12-31)</option>
                    <option value="MM/DD/YYYY">MM/DD/YYYY (12/31/2026)</option>
                  </select>
                </div>
              </div>

              <div style="margin-top:8px">
                <button type="button" class="btn btn-primary" id="save-settings-btn" onclick="saveCompanySettings()" style="display:inline-flex;align-items:center;gap:8px">
                  <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span>Sozlamalarni saqlash</span>
                </button>
              </div>
            </form>
          </div>
        </div>

        <!-- ============ O'NG: TIZIM, INTERFEYS VA PROFIL ============ -->
        <div style="display:flex;flex-direction:column;gap:24px">

          <!-- Interfeys mavzusi -->
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">Interfeys va ko'rinish</h3>
            </div>
            <div class="card-body">
              <label class="form-label">Dastur mavzusi (Theme)</label>
              <div class="theme-picker-grid">
                <div class="theme-card-option" id="theme-opt-dark" onclick="selectTheme('dark')">
                  <div class="theme-icon" style="background:#0f172a;color:#60a5fa;display:flex;align-items:center;justify-content:center">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
                    </svg>
                  </div>
                  <div>
                    <div style="font-size:13px;font-weight:600">Tungi mavzu</div>
                    <div style="font-size:11px;color:var(--text-muted)">Dark mode (Tavsiya)</div>
                  </div>
                </div>
                <div class="theme-card-option" id="theme-opt-light" onclick="selectTheme('light')">
                  <div class="theme-icon" style="background:#f1f5f9;color:#eab308;display:flex;align-items:center;justify-content:center">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
                    </svg>
                  </div>
                  <div>
                    <div style="font-size:13px;font-weight:600">Kunduzgi mavzu</div>
                    <div style="font-size:11px;color:var(--text-muted)">Light mode</div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Xavfsizlik va Profil havolalari -->
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">Profil va xavfsizlik</h3>
              <a href="/profile" class="text-sm">Batafsil →</a>
            </div>
            <div class="card-body" style="display:flex;flex-direction:column;gap:10px">
              <a href="/profile" class="quick-link-item">
                <div style="display:flex;align-items:center;gap:10px">
                  <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:#60a5fa">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                  </svg>
                  <div>
                    <div style="font-size:13px;font-weight:600">Shaxsiy ma'lumotlar</div>
                    <div style="font-size:11px;color:var(--text-muted)">Ism, telefon va login sozlamalari</div>
                  </div>
                </div>
                <span>→</span>
              </a>

              <a href="/profile" class="quick-link-item">
                <div style="display:flex;align-items:center;gap:10px">
                  <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:#34d399">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                  </svg>
                  <div>
                    <div style="font-size:13px;font-weight:600">Parolni yangilash</div>
                    <div style="font-size:11px;color:var(--text-muted)">Maxfiylik va hisob xavfsizligi</div>
                  </div>
                </div>
                <span>→</span>
              </a>

              <a href="/audit-logs" class="quick-link-item">
                <div style="display:flex;align-items:center;gap:10px">
                  <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:#fbbf24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
                  </svg>
                  <div>
                    <div style="font-size:13px;font-weight:600">Harakatlar tarixi (Audit)</div>
                    <div style="font-size:11px;color:var(--text-muted)">Amallar va kirishlar jurnali</div>
                  </div>
                </div>
                <span>→</span>
              </a>
            </div>
          </div>

          <!-- Tizim holati va zaxira -->
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">Tizim holati</h3>
              <span class="badge badge-success">Barqaror</span>
            </div>
            <div class="card-body">
              <div class="sys-stat-row">
                <span style="color:var(--text-muted)">Ma'lumotlar bazasi</span>
                <span style="font-weight:600;color:var(--success)">PostgreSQL (Ulangan)</span>
              </div>
              <div class="sys-stat-row">
                <span style="color:var(--text-muted)">Backend arxitekturasi</span>
                <span style="font-weight:500">Node.js Express &bull; Prisma ORM</span>
              </div>
              <div class="sys-stat-row">
                <span style="color:var(--text-muted)">API holati</span>
                <span style="font-weight:500">RESTful v1.0 &bull; 100% Faol</span>
              </div>
              <div style="margin-top:16px;display:flex;gap:10px">
                <button type="button" class="btn btn-secondary btn-sm" onclick="Toast.info('Zaxira nusxa (backup) yaratish server fonida rejalashtirildi')">
                  <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
                  </svg>
                  Zaxira nusxa yaratish
                </button>
              </div>
            </div>
          </div>

        </div>
      </div>
    </main>
  </div>
</div>

<div id="toast-container" class="toast-container"></div>

<%- include('../partials/scripts') %>

<script>
  if (!Layout.init()) throw new Error('Auth failed');
  Layout.setBreadcrumb([{label: 'Boshqaruv'}, {label: 'Sozlamalar'}]);

  // Telefon input maskasi
  Utils.setupPhoneInput('set-phone');
  // Korxona manzili auto-grow
  Utils.setupAutoGrow('set-address', 140);

  // Mavzu holatini o'rnatish
  function updateThemeUI() {
    const theme = ThemeManager.getCurrent();
    const optDark = document.getElementById('theme-opt-dark');
    const optLight = document.getElementById('theme-opt-light');
    if (theme === 'light') {
      optLight?.classList.add('active');
      optDark?.classList.remove('active');
    } else {
      optDark?.classList.add('active');
      optLight?.classList.remove('active');
    }
  }

  function selectTheme(theme) {
    ThemeManager.apply(theme);
    updateThemeUI();
    Toast.success(theme === 'dark' ? 'Tungi mavzu yoqildi' : 'Kunduzgi mavzu yoqildi');
  }

  updateThemeUI();

  // Korxona sozlamalarini yuklash
  async function loadSettings() {
    try {
      const res = await api.get('/settings');
      if (res.data) {
        const s = res.data;
        document.getElementById('set-companyName').value = s.companyName || '';
        document.getElementById('set-phone').value = s.phone || '';
        document.getElementById('set-taxId').value = s.taxId || '';
        const addrEl = document.getElementById('set-address');
        addrEl.value = s.address || '';
        addrEl.dispatchEvent(new Event('input'));
        if (s.currency) document.getElementById('set-currency').value = s.currency;
        if (s.dateFormat) document.getElementById('set-dateFormat').value = s.dateFormat;
      }
    } catch (e) {
      Toast.error(e.message || 'Sozlamalarni yuklab bo\'lmadi');
    }
  }

  // Korxona sozlamalarini saqlash
  async function saveCompanySettings() {
    Utils.clearFormErrors('settings-form');
    const nameInput = document.getElementById('set-companyName');
    const name = nameInput.value.trim();
    const errEl = document.getElementById('set-companyName-error');

    if (!name) {
      nameInput.classList.add('is-invalid');
      nameInput.classList.add('error');
      if (errEl) errEl.textContent = 'Korxona nomi kiritilishi shart';
      Toast.error('Korxona nomi kiritilishi shart');
      nameInput.focus();
      return;
    }

    const saveBtn = document.getElementById('save-settings-btn');
    const originalBtnText = saveBtn.innerHTML;
    saveBtn.disabled = true;
    saveBtn.innerHTML = '<span>Saqlanmoqda...</span>';

    try {
      await api.put('/settings', {
        companyName: name,
        phone: document.getElementById('set-phone').value.trim() || undefined,
        taxId: document.getElementById('set-taxId').value.trim() || undefined,
        address: document.getElementById('set-address').value.trim() || undefined,
        currency: document.getElementById('set-currency').value,
        dateFormat: document.getElementById('set-dateFormat').value
      });
      Toast.success('Korxona sozlamalari muvaffaqiyatli saqlandi');
    } catch (e) {
      Utils.handleApiError(e, 'settings-form');
    } finally {
      saveBtn.disabled = false;
      saveBtn.innerHTML = originalBtnText;
    }
  }

  loadSettings();
</script>
</body>
</html>
