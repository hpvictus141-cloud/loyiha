<!DOCTYPE html>
<html lang="uz" data-theme="dark">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <div class="admin-layout" id="admin-layout">
    <%- include('../partials/sidebar') %>
    
    <div class="main-content">
      <%- include('../partials/navbar') %>
      
      <main class="page-content">
        <div class="page-header">
          <div>
            <h1 class="page-title" id="greeting-text">Dashboard</h1>
            <p class="page-subtitle">Omborxona boshqaruv tizimi</p>
          </div>
        </div>

        <div class="stats-cards" id="stats-cards">
          <!-- Stats will be loaded here -->
        </div>

        <div class="grid grid-2">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">Kirim-Chiqim Harakati</h3>
            </div>
            <div class="card-body">
              <div class="bar-chart">
                <div class="bar-chart-item">
                  <div class="bar-chart-label">Kirim</div>
                  <div class="bar-chart-track">
                    <div class="bar-chart-fill" id="kirim-bar" style="width:0%;background:linear-gradient(90deg,#3b82f6 0%,#2563eb 100%)">
                      <span class="bar-chart-value" id="kirim-val">0</span>
                    </div>
                  </div>
                </div>
                <div class="bar-chart-item">
                  <div class="bar-chart-label">Chiqim</div>
                  <div class="bar-chart-track">
                    <div class="bar-chart-fill" id="chiqim-bar" style="width:0%;background:linear-gradient(90deg,#3b82f6 0%,#2563eb 100%)">
                      <span class="bar-chart-value" id="chiqim-val">0</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="card">
            <div class="card-header">
              <h3 class="card-title">Bugungi Statistika</h3>
            </div>
            <div class="card-body">
              <div class="bar-chart">
                <div class="bar-chart-item">
                  <div class="bar-chart-label">Kirim</div>
                  <div class="bar-chart-track">
                    <div class="bar-chart-fill" id="kirim2-bar" style="width:0%;background:linear-gradient(90deg,#3b82f6 0%,#2563eb 100%)">
                      <span class="bar-chart-value" id="kirim2-val">0</span>
                    </div>
                  </div>
                </div>
                <div class="bar-chart-item">
                  <div class="bar-chart-label">Chiqim</div>
                  <div class="bar-chart-track">
                    <div class="bar-chart-fill" id="chiqim2-bar" style="width:0%;background:linear-gradient(90deg,#3b82f6 0%,#2563eb 100%)">
                      <span class="bar-chart-value" id="chiqim2-val">0</span>
                    </div>
                  </div>
                </div>
                <div class="bar-chart-item">
                  <div class="bar-chart-label">Yetkazib beruvchilar</div>
                  <div class="bar-chart-track">
                    <div class="bar-chart-fill" id="supplier-bar" style="width:0%;background:linear-gradient(90deg,#3b82f6 0%,#2563eb 100%)">
                      <span class="bar-chart-value" id="supplier-val">0</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <h3 class="card-title">Kam Qolgan Mahsulotlar</h3>
            <div class="card-actions">
              <button type="button" class="card-action-btn" onclick="Layout.toggleCard(this)" title="Yig'ish / Yoyish" aria-label="Yig'ish yoki yoyish">
                <svg class="card-toggle-icon" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </button>
            </div>
          </div>
          <div class="card-body">
            <div class="table-container">
              <table class="table">
                <thead>
                  <tr>
                    <th>Mahsulot</th>
                    <th>Joriy qoldiq</th>
                    <th>Minimal</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody id="low-stock-table">
                  <tr>
                    <td colspan="4">
                      <div class="empty-state" style="padding:30px">
                        <p class="empty-state-description">Ma'lumotlar yuklanmoqda...</p>
                      </div>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <div class="grid grid-2">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">So'nggi Kirimlar</h3>
              <div class="card-actions">
                <button type="button" class="card-action-btn" onclick="Layout.toggleCard(this)" title="Yig'ish / Yoyish" aria-label="Yig'ish yoki yoyish">
                  <svg class="card-toggle-icon" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </button>
              </div>
            </div>
            <div class="card-body">
              <div class="table-container">
                <table class="table">
                  <thead>
                    <tr>
                      <th>Mahsulot</th>
                      <th>Miqdor</th>
                      <th>Sana</th>
                    </tr>
                  </thead>
                  <tbody id="recent-stock-in-table">
                    <tr>
                      <td colspan="3">
                        <div class="empty-state" style="padding:30px">
                          <p class="empty-state-description">Ma'lumotlar yuklanmoqda...</p>
                        </div>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <div class="card">
            <div class="card-header">
              <h3 class="card-title">So'nggi Chiqimlar</h3>
              <div class="card-actions">
                <button type="button" class="card-action-btn" onclick="Layout.toggleCard(this)" title="Yig'ish / Yoyish" aria-label="Yig'ish yoki yoyish">
                  <svg class="card-toggle-icon" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </button>
              </div>
            </div>
            <div class="card-body">
              <div class="table-container">
                <table class="table">
                  <thead>
                    <tr>
                      <th>Mahsulot</th>
                      <th>Miqdor</th>
                      <th>Qabul qiluvchi</th>
                    </tr>
                  </thead>
                  <tbody id="recent-stock-out-table">
                    <tr>
                      <td colspan="3">
                        <div class="empty-state" style="padding:30px">
                          <p class="empty-state-description">Ma'lumotlar yuklanmoqda...</p>
                        </div>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <div id="toast-container" class="toast-container"></div>

  <%- include('../partials/scripts') %>
  
  <script>
    try {
      Layout.init();
      Layout.setBreadcrumb([{label: 'Dashboard'}]);
    } catch (err) {
      console.warn('Layout init warning:', err);
    }

    const now = new Date();
    const hours = now.getHours();
    let greet = hours < 12 ? 'Xayrli tong' : hours < 17 ? 'Xayrli kun' : 'Xayrli kech';
    const user = Auth.getUser();
    const greetingIcon = '<svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display:inline-block;vertical-align:middle;margin-left:8px"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"/></svg>';
    const greetEl = document.getElementById('greeting-text');
    if (greetEl) greetEl.innerHTML = `${greet}, ${user?.fullName || 'Foydalanuvchi'} ${greetingIcon}`;

    async function loadDashboard() {
      const user = Auth.getUser();
      const isAdmin = user?.role?.name === 'Admin';
      
      try {
        const data = await api.get('/dashboard/stats');
        if (!data || !data.data) return;
        const { stats, lowStockProducts, recentStockIns, recentStockOuts } = data.data;
        if (stats) {
          renderStats(stats, isAdmin);
          renderSimpleCharts(stats);
        }
        renderLowStock(lowStockProducts || []);
        renderRecentStockIn(recentStockIns || []);
        renderRecentStockOut(recentStockOuts || []);
      } catch (e) {
        console.error('Dashboard Error:', e);
        if (typeof Toast !== 'undefined') Toast.error(e.message);
      }
    }

    function renderStats(stats, isAdmin) {
      if (isAdmin) {
        document.getElementById('stats-cards').innerHTML = `
          <div class="stat-card">
            <div class="stat-card-icon" style="background:rgba(59,130,246,0.15)">
              <svg width="28" height="28" fill="none" stroke="#3b82f6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
            </div>
            <div class="stat-card-body">
              <div class="stat-card-label">Jami mahsulotlar</div>
              <div class="stat-card-value" data-value="${stats.products}">${Utils.formatNumber(stats.products)}</div>
              <div class="stat-card-meta">
                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                ${stats.categories} ta kategoriya
              </div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-card-icon" style="background:rgba(59,130,246,0.15)">
              <svg width="28" height="28" fill="none" stroke="#3b82f6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
            </div>
            <div class="stat-card-body">
              <div class="stat-card-label">Bugungi kirim</div>
              <div class="stat-card-value" data-value="${stats.todayStockIns}">${Utils.formatNumber(stats.todayStockIns)}</div>
              <div class="stat-card-meta">
                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                ${Utils.formatCurrency(stats.todayStockInValue)}
              </div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-card-icon" style="background:rgba(59,130,246,0.15)">
              <svg width="28" height="28" fill="none" stroke="#3b82f6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6"/></svg>
            </div>
            <div class="stat-card-body">
              <div class="stat-card-label">Bugungi chiqim</div>
              <div class="stat-card-value" data-value="${stats.todayStockOuts}">${Utils.formatNumber(stats.todayStockOuts)}</div>
              <div class="stat-card-meta">
                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                Operatsiyalar soni
              </div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-card-icon" style="background:rgba(59,130,246,0.15)">
              <svg width="28" height="28" fill="none" stroke="#3b82f6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            </div>
            <div class="stat-card-body">
              <div class="stat-card-label">Kam qolgan</div>
              <div class="stat-card-value" data-value="${stats.lowStock}">${Utils.formatNumber(stats.lowStock)}</div>
              <div class="stat-card-meta">
                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/></svg>
                Minimal darajadan past
              </div>
            </div>
          </div>
        `;
      } else {
        document.getElementById('stats-cards').innerHTML = `
          <div class="stat-card">
            <div class="stat-card-icon" style="background:rgba(59,130,246,0.15)">
              <svg width="28" height="28" fill="none" stroke="#3b82f6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
            </div>
            <div class="stat-card-body">
              <div class="stat-card-label">Jami mahsulotlar</div>
              <div class="stat-card-value" data-value="${stats.products}">${Utils.formatNumber(stats.products)}</div>
              <div class="stat-card-meta">${stats.categories} ta kategoriya</div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-card-icon" style="background:rgba(59,130,246,0.15)">
              <svg width="28" height="28" fill="none" stroke="#3b82f6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
            </div>
            <div class="stat-card-body">
              <div class="stat-card-label">Kategoriyalar</div>
              <div class="stat-card-value" data-value="${stats.categories}">${Utils.formatNumber(stats.categories)}</div>
              <div class="stat-card-meta">Faol kategoriyalar</div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-card-icon" style="background:rgba(59,130,246,0.15)">
              <svg width="28" height="28" fill="none" stroke="#3b82f6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            </div>
            <div class="stat-card-body">
              <div class="stat-card-label">Kam qolgan</div>
              <div class="stat-card-value" data-value="${stats.lowStock}">${Utils.formatNumber(stats.lowStock)}</div>
              <div class="stat-card-meta">Minimal darajadan past</div>
            </div>
          </div>
        `;
      }
      
      // Animated counter o'chirildi - tezroq ishlashi uchun
    }

    function renderLowStock(products) {
      const tbody = document.getElementById('low-stock-table');
      if (!products?.length) {
        tbody.innerHTML = `<tr><td colspan="4"><div class="empty-state" style="padding:30px"><p class="empty-state-description">Kam qolgan mahsulot yo'q</p></div></td></tr>`;
        return;
      }
      tbody.innerHTML = products.map(p => `
        <tr>
          <td><span style="font-weight:500">${Utils.escapeHtml(p.name)}</span></td>
          <td>${Utils.formatNumber(p.currentStock)} ${Utils.escapeHtml(p.unit?.symbol || '')}</td>
          <td>${Utils.formatNumber(p.minStock)} ${Utils.escapeHtml(p.unit?.symbol || '')}</td>
          <td><span class="badge badge-danger">Kam</span></td>
        </tr>
      `).join('');
    }

    function renderRecentStockIn(items) {
      const tbody = document.getElementById('recent-stock-in-table');
      if (!tbody) return;
      if (!items?.length) {
        tbody.innerHTML = `<tr><td colspan="3"><div class="empty-state" style="padding:30px"><p class="empty-state-description">Kirim yo'q</p></div></td></tr>`;
        return;
      }
      tbody.innerHTML = items.map(s => `
        <tr>
          <td><span style="font-weight:500">${Utils.escapeHtml(s.product?.name || '-')}</span></td>
          <td>${Utils.formatNumber(s.quantity)} ${Utils.escapeHtml(s.product?.unit?.symbol || '')}</td>
          <td>${Utils.formatDate(s.date)}</td>
        </tr>
      `).join('');
    }

    function renderRecentStockOut(items) {
      const tbody = document.getElementById('recent-stock-out-table');
      if (!tbody) return;
      if (!items?.length) {
        tbody.innerHTML = `<tr><td colspan="3"><div class="empty-state" style="padding:30px"><p class="empty-state-description">Chiqim yo'q</p></div></td></tr>`;
        return;
      }
      tbody.innerHTML = items.map(s => `
        <tr>
          <td><span style="font-weight:500">${Utils.escapeHtml(s.product?.name || '-')}</span></td>
          <td>${Utils.formatNumber(s.quantity)} ${Utils.escapeHtml(s.product?.unit?.symbol || '')}</td>
          <td><span class="badge badge-secondary" style="font-size:11px;">${Utils.escapeHtml(s.recipientName || '-')}</span></td>
        </tr>
      `).join('');
    }

    function renderSimpleCharts(stats) {
      if (!stats) return;
      const kirimVal = stats.todayStockIns || 0;
      const chiqimVal = stats.todayStockOuts || 0;
      const supplierVal = stats.suppliers || 0;
      
      const maxVal = Math.max(kirimVal, chiqimVal, supplierVal, 10);
      
      const kirimPercent = Math.min(100, Math.round((kirimVal / maxVal) * 100));
      const chiqimPercent = Math.min(100, Math.round((chiqimVal / maxVal) * 100));
      const supplierPercent = Math.min(100, Math.round((supplierVal / maxVal) * 100));
      
      const setWidth = (id, pct) => { const el = document.getElementById(id); if (el) el.style.width = pct + '%'; };
      const setText = (id, txt) => { const el = document.getElementById(id); if (el) el.textContent = txt; };

      setWidth('kirim-bar', kirimPercent);
      setWidth('chiqim-bar', chiqimPercent);
      setWidth('kirim2-bar', kirimPercent);
      setWidth('chiqim2-bar', chiqimPercent);
      setWidth('supplier-bar', supplierPercent);
      
      setText('kirim-val', kirimVal);
      setText('chiqim-val', chiqimVal);
      setText('kirim2-val', kirimVal);
      setText('chiqim2-val', chiqimVal);
      setText('supplier-val', supplierVal);
    }

    loadDashboard();
  </script>
</body>
</html>
