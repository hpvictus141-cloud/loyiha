<!DOCTYPE html>
<html lang="uz">
<head>
  <%- include('../partials/head') %>
  <style>
    body {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      background: linear-gradient(135deg, #0a0e1a 0%, #0f1419 100%);
      color: #fff;
      text-align: center;
      padding: 20px;
    }
    .error-container {
      max-width: 600px;
    }
    .error-code {
      font-size: 120px;
      font-weight: 900;
      background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      line-height: 1;
      margin-bottom: 20px;
    }
    .error-message {
      font-size: 24px;
      font-weight: 600;
      margin-bottom: 10px;
    }
    .error-description {
      font-size: 16px;
      color: rgba(255, 255, 255, 0.6);
      margin-bottom: 30px;
    }
    .btn {
      display: inline-block;
      padding: 12px 24px;
      background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
      color: #fff;
      text-decoration: none;
      border-radius: 8px;
      font-weight: 600;
      transition: transform 0.2s;
    }
    .btn:hover {
      transform: translateY(-2px);
    }
  </style>
</head>
<body>
  <div class="error-container">
    <div class="error-code">404</div>
    <h1 class="error-message">Sahifa topilmadi</h1>
    <p class="error-description">Kechirasiz, siz qidirayotgan sahifa mavjud emas yoki ko'chirilgan.</p>
    <a href="/" class="btn">Bosh sahifaga qaytish</a>
  </div>
</body>
</html>
