# Vercel Production Environment Variables
# Vercel Dashboard > Project Settings > Environment Variables bo'limiga qo'shing:

# 1. Bulutli PostgreSQL ulanish manzili (Neon.tech, Supabase yoki Railway)
# Misol: postgresql://username:password@ep-xyz.region.aws.neon.tech/warehouse_db?sslmode=require
DATABASE_URL="postgresql://username:password@your-cloud-db-host:5432/warehouse_db?sslmode=require"

# 2. Xavfsizlik kalitlari (JWT)
JWT_SECRET="warehouse-production-super-secret-jwt-key-change-this-2026"
JWT_REFRESH_SECRET="warehouse-production-super-secret-refresh-key-change-this-2026"
JWT_EXPIRE="24h"
JWT_REFRESH_EXPIRE="7d"

# 3. Muhit sozlamalari
NODE_ENV="production"
PORT=3010
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=2500
